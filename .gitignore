# Unity - https://github.com/github/gitignore/blob/main/Unity.gitignore
# Đặt file này tại thư mục gốc project Unity (cùng cấp với Assets/)

.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender backup
*.blend1
*.blend1.meta

# MemoryCaptures - dung lượng lớn, có thể chứa dữ liệu nhạy cảm
/[Mm]emoryCaptures/

# Recordings - dung lượng lớn
/[Rr]ecordings/

# Jetbrains Rider
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio
.vs/

# Gradle (Android build)
.gradle/

# Solution & project files (auto-generated)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity meta cho file build
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*

# Build output
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics
crashlytics-build.properties

# TestRunner
InitTestScene*.unity*

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Play mode test scenes
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# --- OS & Editor ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# VSCode (nếu dùng)
.vscode/
!.vscode/*.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
